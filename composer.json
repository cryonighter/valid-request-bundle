{
    "name": "cryonighter/valid-request-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle for building and validating objects from HTTP request data",
    "homepage": "https://github.com/cryonighter/valid-request-bundle",
    "license": "MIT",
    "keywords": ["symfony", "validation", "validator", "validated", "valid", "violation", "request", "DTO", "bundle"],
    "authors": [
        {
            "name": "Andrey Reshetchenko",
            "email": "cryonighter@yandex.ru"
        }
    ],
    "require": {
        "php": ">=8.4",
        "symfony/dependency-injection": ">=6.4",
        "symfony/http-kernel": ">=6.4",
        "symfony/mime": ">=6.4",
        "symfony/validator": ">=6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": ">=6.4",
        "symfony/css-selector": ">=6.4",
        "symfony/dom-crawler": ">=6.4",
        "symfony/intl": ">=6.4",
        "symfony/framework-bundle": ">=6.4",
        "symfony/phpunit-bridge": ">=6.4",
        "symfony/yaml": ">=6.4"
    },
    "autoload": {
        "psr-4": {
            "Cryonighter\\ValidRequestBundle\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Cryonighter\\ValidRequestBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4"
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false
        }
    }
}
